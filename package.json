    ]
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "highlight.js": "10.7.3",
    "yaml": "^2.9.0"
  }
